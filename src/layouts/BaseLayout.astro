---
import "../styles/global.css";
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_URL,
  OG_IMAGE,
  RELEASE_READY,
} from "../data/site";

interface Props {
  /** ページ固有のタイトル。省略時はアプリ名のみ */
  title?: string;
  /** ページ固有の説明。省略時はサイト既定 */
  description?: string;
  /**
   * 404 など、リリース状況にかかわらず常に検索結果から除外したいページで true。
   * true のときは canonical も出さない（自分自身を正典として宣言すべきページではない）。
   */
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(OG_IMAGE, SITE_URL).href;

// DMG 未公開の間はサイト全体を noindex にする（下のコメント参照）
const isNoindex = noindex || !RELEASE_READY;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/*
      canonical を落とすのは 404 のような「自分自身を正典として宣言すべきでない」
      ページだけ。RELEASE_READY 由来の一時的な noindex では canonical は残す。
    */}
    {!noindex && <link rel="canonical" href={canonical} />}

    {/*
      DMG 未公開の間はプレースホルダー画像と非活性 CTA しか無いので検索結果に出さない。
      RELEASE_READY を true にすると自動で外れる（消し忘れが起きない）。
      404 ページは noindex prop で常に除外する。
    */}
    {isNoindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
