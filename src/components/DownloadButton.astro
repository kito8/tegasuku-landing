---
import { DOWNLOAD_URL, RELEASE_READY } from "../data/site";

interface Props {
  /** ボタン文言（DL可能時） */
  label?: string;
  /** 見た目: primary=塗り, secondary=枠線 */
  variant?: "primary" | "secondary";
  /** 追加クラス */
  class?: string;
}

const {
  label = "macOS版をダウンロード",
  variant = "primary",
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-2xl px-6 py-3 text-base font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg";

const styles = {
  primary: "bg-accent text-white shadow-sm hover:bg-accent-ink",
  secondary:
    "border border-line bg-bg text-ink shadow-sm hover:border-accent hover:text-accent",
};

const cls = `${base} ${styles[variant]} ${className}`;
---

{
  RELEASE_READY ? (
    <a href={DOWNLOAD_URL} class={cls} download>
      <slot>{label}</slot>
    </a>
  ) : (
    <span
      class={`${cls} cursor-not-allowed opacity-60`}
      role="button"
      aria-disabled="true"
      title="リリース準備中です"
    >
      まもなく公開
    </span>
  )
}
