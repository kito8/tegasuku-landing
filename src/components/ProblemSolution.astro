---
const problems = [
  "手でスクショを撮り続けるのは面倒。集中していると撮り逃す",
  "画面録画は容量が大きく、共有にも気を使う",
  "クラウドの自動ツールは会議内容を外部サーバーへ送信してしまう",
];
---

<section class="bg-bg-alt">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <header class="max-w-2xl">
      <p class="eyebrow">課題</p>
      <h2
        class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl"
      >
        説明会のスライド、あとで見返したいのに——
      </h2>
    </header>
    <ul class="mt-10 grid gap-4 sm:grid-cols-3">
      {
        problems.map((p) => (
          <li class="card p-6 text-sm leading-relaxed text-subtle">{p}</li>
        ))
      }
    </ul>
    <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink">
      tegasuku は指定した領域の変化を検知して<strong class="font-semibold"
        >自動でスライドだけ保存</strong
      >。しかも<strong class="font-semibold">すべてあなたのMacの中で完結</strong
      >します。
    </p>
  </div>
</section>
