---
const problems = [
  "手でスクショを撮り続けるのは面倒。集中していると撮り逃す",
  "画面録画は容量が大きく、共有にも気を使う",
  "クラウドの自動ツールは会議内容を外部サーバーへ送信してしまう",
];
---

<section class="bg-bg-alt">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      説明会のスライド、あとで見返したいのに——
    </h2>
    <ul class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
      {
        problems.map((p) => (
          <li class="rounded-2xl border border-line bg-bg p-6 text-sm leading-relaxed text-subtle">
            {p}
          </li>
        ))
      }
    </ul>
    <p class="mx-auto mt-10 max-w-2xl text-center text-lg leading-relaxed text-ink">
      tegasuku は指定した領域の変化を検知して<strong class="font-semibold"
        >自動でスライドだけ保存</strong
      >。しかも<strong class="font-semibold">すべてあなたのMacの中で完結</strong>します。
    </p>
  </div>
</section>
