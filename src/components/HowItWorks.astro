---
const steps = [
  {
    title: "範囲を選ぶ",
    body: "ウィンドウのプレビュー上でスライド領域をドラッグ指定（ROI）。",
  },
  {
    title: "自動でキャプチャ",
    body: "スライドが切り替わるたびに自動撮影。手動は Cmd+Shift+S でも撮れる。",
  },
  {
    title: "PDFで書き出し",
    body: "撮ったスライドをサムネイルで管理・並び替えし、1クリックでPDF化。",
  },
];
---

<section class="bg-bg-alt">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      使い方は3ステップ
    </h2>
    <ol class="mt-12 grid gap-8 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="flex flex-col items-center text-center">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-lg font-bold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-subtle">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
