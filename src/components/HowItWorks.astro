---
const steps = [
  {
    title: "範囲を選ぶ",
    body: "ウィンドウのプレビュー上で、スライドが映る矩形領域（ROI）をドラッグ指定。",
  },
  {
    title: "自動でキャプチャ",
    body: "スライドが切り替わるたびに自動で撮影。撮り逃しも重複もなし。",
    key: "Cmd+Shift+S",
  },
  {
    title: "PDFで書き出し",
    body: "撮ったスライドをサムネイルで管理・並び替えし、1クリックでPDF化。",
  },
];
---

<section class="bg-bg-alt">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <header class="max-w-2xl">
      <p class="eyebrow">使い方</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        使い方は3ステップ
      </h2>
    </header>
    <ol class="mt-12 grid gap-8 sm:grid-cols-3">
      {
        steps.map((s, i) => (
          <li class="flex flex-col">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent font-mono text-lg font-semibold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-subtle">{s.body}</p>
            {
              s.key && (
                <p class="mt-3 text-sm text-subtle">
                  手動撮影は <span class="tok">{s.key}</span>
                </p>
              )
            }
          </li>
        ))
      }
    </ol>
  </div>
</section>
